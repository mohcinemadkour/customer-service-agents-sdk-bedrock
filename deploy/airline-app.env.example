# /etc/airline-app.env  (copy, fill in, chmod 600)
# Models: the "litellm/" prefix makes the Agents SDK call the model through LiteLLM -> Amazon Bedrock.
AGENT_MODEL=litellm/bedrock/global.anthropic.claude-sonnet-4-6
GUARDRAIL_MODEL=litellm/bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION_NAME=us-east-2
AWS_DEFAULT_REGION=us-east-2
# Not used for any call; some SDK code paths check that the variable exists.
OPENAI_API_KEY=not-used-bedrock-only
# Self-hosted Langfuse (leave the keys empty to turn tracing off)
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_TRACING_ENVIRONMENT=lab
